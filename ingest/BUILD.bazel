load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "ingest",
    srcs = [
        "flusher.go",
        "ingester.go",
    ],
    importpath = "github.com/iampat/cloudy-neigh/ingest",
    visibility = ["//visibility:public"],
    deps = [
        "//logstream",
        "//manifest",
        "//namespace",
        "//objectstore",
        "//proto/cloudyneigh/v1:cloudyneigh",
        "//proto/storage/v1:storage",
        "//segment",
        "@org_golang_google_protobuf//proto",
        "@org_golang_x_sync//errgroup",
    ],
)

go_test(
    name = "ingest_test",
    srcs = [
        "flusher_test.go",
        "ingester_test.go",
    ],
    deps = [
        ":ingest",
        "//logstream",
        "//manifest",
        "//namespace",
        "//objectstore",
        "//proto/cloudyneigh/v1:cloudyneigh",
        "//proto/storage/v1:storage",
        "//segment",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)
