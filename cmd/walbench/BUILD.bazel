load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "walbench_lib",
    srcs = ["main.go"],
    importpath = "github.com/iampat/cloudy-neigh/cmd/walbench",
    visibility = ["//visibility:private"],
    deps = [
        "//logstream",
        "//objectstore",
        "@org_golang_x_sync//errgroup",
    ],
)

go_binary(
    name = "walbench",
    embed = [":walbench_lib"],
    visibility = ["//visibility:public"],
)
