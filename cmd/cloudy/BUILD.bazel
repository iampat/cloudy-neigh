load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "cloudy_lib",
    srcs = ["main.go"],
    importpath = "github.com/iampat/cloudy-neigh/cmd/cloudy",
    visibility = ["//visibility:private"],
    deps = [
        "//grpcapi",
        "//ingest",
        "//logstream",
        "//objectstore",
        "//proto/cloudyneigh/v1:cloudyneigh",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_x_sync//errgroup",
    ],
)

go_binary(
    name = "cloudy",
    embed = [":cloudy_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "cloudy_test",
    srcs = ["main_test.go"],
    embed = [":cloudy_lib"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
