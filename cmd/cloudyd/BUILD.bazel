load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "cloudyd_lib",
    srcs = ["main.go"],
    importpath = "github.com/iampat/cloudy-neigh/cmd/cloudyd",
    visibility = ["//visibility:private"],
    deps = [
        "//grpcapi",
        "//logstream",
        "//objectstore",
        "//proto/cloudyneigh/v1:cloudyneighpb_go_proto",
        "@org_golang_google_grpc//:grpc",
    ],
)

go_binary(
    name = "cloudyd",
    embed = [":cloudyd_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "cloudyd_test",
    srcs = ["main_test.go"],
    embed = [":cloudyd_lib"],
    deps = [
        "//logstream",
        "//proto/cloudyneigh/v1:cloudyneighpb_go_proto",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
    ],
)
