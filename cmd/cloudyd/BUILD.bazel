load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "cloudyd_lib",
    srcs = ["main.go"],
    importpath = "github.com/iampat/cloudy-neigh/cmd/cloudyd",
    visibility = ["//visibility:private"],
    deps = [
        "//grpcapi",
        "//ingest",
