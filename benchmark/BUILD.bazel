load("@rules_python//python:defs.bzl", "py_binary", "py_library")

py_binary(
    name = "demoload",
    srcs = ["demoload.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":interceptor",
        "//proto/cloudyneigh/v1:cloudyneighpb_py_grpc",
        "@pip//absl_py",
