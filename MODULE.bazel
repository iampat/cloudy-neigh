module(
    name = "cloudy-neigh",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "protobuf", version = "35.1")


bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.4", dev_dependency = True)
bazel_dep(name = "aspect_rules_lint", version = "2.9.0", dev_dependency = True)

bazel_dep(name = "rules_python", version = "2.3.3")
bazel_dep(name = "rules_python_gazelle_plugin", version = "2.3.3")
bazel_dep(name = "rules_proto_grpc_python", version = "5.8.0")
bazel_dep(name = "grpc", version = "1.83.0")
bazel_dep(name = "rules_uv", version = "0.89.2")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip",
    python_version = "3.12",
    requirements_lock = "//:requirements.txt",
)
use_repo(pip, "pip")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26")
go_sdk.download(version = "1.27")
go_sdk.nogo(nogo = "//:nogo")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# nogo reads export data with golang.org/x/tools. rules_go 0.62.0 pins v0.34.0,
# which decodes export data to version 2 at most. Go 1.27 writes version 4, so
# every nogo action fails under --config=go1.27. x/tools v0.44.0 added version 4.
# Remove this override when rules_go pins v0.44.0 or later.
go_deps.module(
    path = "golang.org/x/tools",
    sum = "h1:3NI7VXzL9+1WZD52Dx2ttoPwD5DWrFGpl9mFZDlmisI=",
    version = "v0.49.0",
)
use_repo(go_deps, "com_github_stretchr_testify", "com_google_cloud_go_storage", "org_golang_google_api", "org_golang_google_grpc", "org_golang_google_protobuf", "org_golang_x_sync", "org_golang_x_tools")
