module(
    name = "cloudy-neigh",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.62.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.52.2", repo_name = "bazel_gazelle")
bazel_dep(name = "protobuf", version = "35.1", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_proto", version = "7.1.0")

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)
bazel_dep(name = "aspect_rules_lint", version = "2.7.2", dev_dependency = True)

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.5")
go_sdk.download(version = "1.27.0")
go_sdk.nogo(nogo = "//:nogo")

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# nogo reads export data with golang.org/x/tools. rules_go 0.62.0 pins v0.34.0,
# which decodes export data to version 2 at most. Go 1.27 writes version 4, so
# every nogo action fails under --config=go1.27. x/tools v0.44.0 added version 4.
# Remove this override when rules_go pins v0.44.0 or later.
go_deps.module(
    path = "golang.org/x/tools",
    sum = "h1:3NI7VXzL9+1WZD52Dx2ttoPwD5DWrFGpl9mFZDlmisI=",
    version = "v0.49.0",
)
use_repo(go_deps, "com_github_stretchr_testify", "com_google_cloud_go_storage", "dev_gocloud", "org_golang_x_tools")
