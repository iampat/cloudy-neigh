load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "namespace",
    srcs = [
        "branch.go",
        "catalog.go",
        "namespace.go",
    ],
    importpath = "github.com/iampat/cloudy-neigh/namespace",
    visibility = ["//visibility:public"],
    deps = [
        "//objectstore",
        "//proto/namespace/v1:namespace",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
