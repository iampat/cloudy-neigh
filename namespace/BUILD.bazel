)

go_test(
    name = "namespace_test",
    srcs = [
        "branch_test.go",
        "catalog_test.go",
        "namespace_test.go",
    ],
    deps = [
        ":namespace",
        "//objectstore",
        "//proto/namespace/v1:namespace",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)
